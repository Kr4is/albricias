# Optional: a GitHub personal access token with no special scopes, used
# server-side for every *public* edition. Leave it unset and public editions
# are fetched unauthenticated (10 req/min on the search API — fine for
# occasional use, exhausted quickly under load). A visitor's own token is
# only ever used for their private activity, which they opt into in the form.
GITHUB_TOKEN=

# Optional: Umami analytics (https://umami.is). Set both to track page views
# and a few events (edition printed/failed, export) — no cookies, Do Not
# Track honoured, never a username or key. Unset, nothing is loaded.
# UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# UMAMI_WEBSITE_ID=
# UMAMI_DOMAINS=albricias.example.com   # optional: only track on these hosts

# Optional: the key the image proxy (/api/image) signs picture URLs with.
# Unset, one is derived from GITHUB_TOKEN when that's set, or else a random
# one generated at boot (signed URLs then stop verifying across a restart —
# harmless, since nothing is stored).
IMAGE_PROXY_SECRET=

# How many sections are written at once (default 2). Set 1 for a
# self-hosted gateway that drops connections under concurrent load.
# ALBRICIAS_SECTION_CONCURRENCY=2

# How long an AI call may stay silent (no token at all) before it is stopped
# with an error instead of leaving the visitor waiting (default 240, min 30).
# ALBRICIAS_LLM_IDLE_SECONDS=240

# Most characters of GitHub material one model call reads (default 60000,
# about 15k tokens). A busy month or quarter is thinned to fit — least
# informative commits first. Lower it for models with a small context window.
# ALBRICIAS_PROMPT_CHARS=60000

# --- Local development only: Mastra Studio (`npm run studio`) -------------
# Runs started from the app always use the visitor's own model. A run
# started from Studio has no visitor, so it uses this one — the same four
# fields as the app's form. Left unset, Studio falls back to
# openai/gpt-4o-mini on OPENAI_API_KEY.
# ALBRICIAS_LLM_PROVIDER=openai        # openai | gemini | litellm
# ALBRICIAS_LLM_API_KEY=
# ALBRICIAS_LLM_MODEL=                 # optional for openai/gemini
# ALBRICIAS_LLM_BASE_URL=              # litellm only, e.g. https://your-gateway/v1

# The Mastra CLI sends anonymous usage telemetry; this turns it off.
# MASTRA_TELEMETRY_DISABLED=1

# Local only: score runs as they happen (Mastra scorers, shown in Studio).
# Unset or 0 = off; 1 = every run; a fraction (0.2) = that share of runs.
ALBRICIAS_SCORERS=
