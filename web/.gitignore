# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Mastra Studio's build cache (`npm run mastra`), and the local store it
# and `next dev` trace runs into — local-only, never committed
/.mastra/
/src/mastra/public/
/mastra.db*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray local sqlite files (no database in this app, but easy to end up
# with one during local experiments)
*.db
*.db-journal
