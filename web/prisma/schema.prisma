// Albricias data layer.
//
// Ported 1:1 from the Flask/SQLAlchemy models under the repo-root `app/models/`,
// with one deliberate generalisation: `Edition` no longer stores `month`/`year`
// integers but a `cadence` + `periodStart`/`periodEnd` range, so weekly and
// monthly editions share one model (see .omc/plans/react-mastra-rewrite.md).
//
// Table and column names are `@map`-ed to the original snake_case SQLite names
// so the Phase 5 migration script can move rows across with a 1:1 mapping.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One publication covering a single period (a week or a month).
/// Ported from `app/models/edition.py`.
model Edition {
  id Int @id @default(autoincrement())

  /// "weekly" | "monthly" — see CADENCE_* in src/lib/edition-helpers.ts.
  cadence String @default("monthly")
  /// Inclusive start of the covered period, at 00:00 UTC.
  periodStart DateTime @map("period_start")
  /// Exclusive end of the covered period, at 00:00 UTC.
  periodEnd DateTime @map("period_end")

  title String
  /// "draft" | "published" — see EDITION_STATUS_* in src/lib/edition-helpers.ts.
  status      String    @default("draft")
  coverImage  String?   @map("cover_image")
  vol         String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// 1–5, which of the front-page layouts (issue_v1 … issue_v5) this edition
  /// renders with — chosen once at random when the edition is created
  /// (`randomLayoutIndex()` in src/lib/layout.ts) and never re-rolled, so the
  /// front page varies edition to edition but stays stable on reload. `null`
  /// for editions created before this column existed; `layoutIndex()` falls
  /// back to the old month-based rotation for those.
  layoutVariant Int? @map("layout_variant")
  /// UTC midnight of the last calendar day this edition's daily generation
  /// job (`processYesterdayIfNeeded` in src/lib/generation/daily.ts) fully
  /// processed — fetched that day's GitHub activity, persisted it, and
  /// surfaced any new star/topic candidates (stars-only, zero AI calls in
  /// the current phase; see that file's header). `null` means no day has
  /// been processed yet (a fresh draft). Advanced only after a day's whole
  /// pipeline succeeds, so a crash mid-day is simply re-processed next run
  /// rather than silently skipped — same "state lives on the row, not in
  /// process memory" convention as generationStatus/generationProgress
  /// below. Deliberately never backfilled past a single day: a gap jumps
  /// this straight to yesterday rather than walking through every missed
  /// day.
  lastProcessedDay DateTime? @map("last_processed_day")
  /// "running" | "done" — tracks the async "Generate with AI" pipeline
  /// (see runEditionGeneration in src/lib/generation/index.ts) so
  /// /admin/editions/[id]/edit can show a live view while it's in progress.
  /// Editions not created through that flow (manual add, migrated data)
  /// are "done" from the start — there is nothing in progress for them.
  generationStatus String @default("done") @map("generation_status")
  /// JSON, nullable, only meaningful while `generationStatus === "running"` —
  /// incremental progress for the live SSE view
  /// (`/admin/editions/[id]/live`), cleared back to `null` once generation
  /// finishes (see the `finally` block in `populateEditionDraft`). Shape:
  ///   {
  ///     sourceProgress: { github: "pending"|"fetching"|"done"|"skipped", blog: ..., spotify: ..., alexandria: ... },
  ///     totalSections: number,
  ///     completedSections: number,
  ///     sections: [{ category: string, status: "pending"|"writing"|"done"|"failed"|"aborted" }]
  ///   }
  generationProgress String? @map("generation_progress")
  /// JSON, nullable, durable (unlike `generationProgress`, never cleared) —
  /// the computed "GitHub monthly stats bank" for this period, populated by
  /// `computeGithubStats()` (`src/lib/github-stats/`) right after the GitHub
  /// fetch step in `populateEditionDraft`, independent of whether an AI
  /// provider is configured (pure arithmetic over this edition's
  /// `ServiceActivity` rows, plus a bounded per-repo language fetch reusing
  /// `fetchRepoLanguages`). `null` when GitHub isn't configured or the
  /// period had zero GitHub activity. See
  /// `.omc/plans/github-monthly-stats-extraction.md` for the full metric
  /// catalog and rationale. Shape:
  ///   {
  ///     temporal: { busiestDay, mostProductiveHour, preferredWeekday, timeOfDaySplit,
  ///                 longestStreakDays, longestGapDays, firstEventAt, lastEventAt },
  ///     volume: { totalCommits, totalPrs, totalIssues, totalReleases, distinctRepos,
  ///               mostActiveRepo, newRepos, starredRepos },
  ///     collaboration: { externalRepos, prsOpened, prsMerged, prsClosedUnmerged,
  ///                      avgPrLifetimeHours, issuesOpened, issuesClosed, reviewsGiven,
  ///                      releasesPublished },
  ///     content: { avgCommitMessageLength, conventionalCommitBreakdown,
  ///                shortestCommitMessage, longestCommitMessage, mostUsedEmoji },
  ///     language: { topLanguagesByBytes: [{ language, bytes }] },
  ///     trend: { vsPreviousPeriod, bestPeriodThisYear, consecutiveActivePeriods } | null
  ///   }
  /// Any group can be partially populated (e.g. `collaboration`'s PR-state
  /// fields omitted if GitHub's API didn't return them for stored rows) —
  /// see the plan's Risks section.
  githubStats String? @map("github_stats")
  /// JSON, nullable, durable — heuristic-scored "topic candidates" for a
  /// deliberate, single-focus piece this period (a tutorial, a deep dive, a
  /// "how I fixed X"), computed by `computeTopicCandidates()`
  /// (`src/lib/topic-candidates/`) from `githubStats` right after it's
  /// computed, independent of whether an AI provider is configured. `null`
  /// exactly when `githubStats` is `null` (no GitHub activity); otherwise
  /// never empty — a "curiosity" candidate is always eligible as a
  /// fallback. These are not finished articles and nothing here decides a
  /// winner — see `.omc/plans/github-topic-candidates.md`. Shape: array of
  ///   {
  ///     id: string,   // stable within this edition, e.g. "release-2" — see computeTopicCandidates()
  ///     kind: "concentration"|"streak"|"newLanguage"|"fastPrVelocity"|
  ///           "bugfixStory"|"release"|"externalContribution"|"curiosity",
  ///     title: string,
  ///     repos: string[],
  ///     bullets: string[],
  ///     score: number,
  ///     scoreBreakdown: { substance: number, originality: number, narrative: number }
  ///   }
  /// sorted by `score` descending, capped at 5.
  topicCandidates String? @map("topic_candidates")
  /// JSON, nullable, durable — which GitHub-insights items the admin has
  /// marked as reviewed/kept, from the curation UI on the edition page. Not
  /// computed automatically like `githubStats`/`topicCandidates` above; only
  /// ever written by the admin's toggle actions. Shape:
  ///   {
  ///     topicCandidateIds: string[], // ids from `topicCandidates` above
  ///     githubStatKeys: string[]     // flat keys into `githubStats`, e.g. "temporal.busiestDay"
  ///   }
  /// Marking/unmarking a topic candidate id also flips the `hidden` flag of
  /// whichever `Article` has that id at `sourceData.topicCandidateId` (see
  /// `Article.hidden` below); marking/unmarking a githubStats key is a pure
  /// annotation with no effect on any article.
  curatorMarks String? @map("curator_marks")

  articles          Article[]
  serviceActivities ServiceActivity[]
  dayProcessingRuns DayProcessingRun[]

  @@unique([cadence, periodStart], map: "uq_edition_cadence_period_start")
  @@index([status])
  @@index([periodStart])
  @@map("editions")
}

/// Individual piece of content within an edition.
/// Ported from `app/models/article.py`.
model Article {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  title    String
  content  String
  category String  @default("General")
  author   String?
  deck     String  @default("A")
  order    Int     @default(0)
  /// Optional dateline. Stored as a DateTime; only the date part is meaningful.
  date DateTime?
  /// UTC midnight of the calendar day this article is *the post for* — set only
  /// by the `day-post` workflow (`@/mastra/workflows/day-post`), `null` on every
  /// other article, including the whole-edition pieces that predate it. Distinct
  /// from `date` above, which is a free-form dateline any article may carry: this
  /// one is a key, and the `(editionId, dayDate)` unique index below is what makes
  /// "a day has at most one post" a database fact rather than a convention —
  /// re-generating a day replaces its post instead of adding a second one.
  /// SQLite treats NULLs as distinct in a unique index, so any number of articles
  /// may keep `dayDate = null`.
  dayDate DateTime? @map("day_date")

  // Media — image/audio stored locally; video is always a URL.
  image String?
  audio String?
  video String?

  /// Provenance: "manual" | "ai_generated" | "github".
  sourceType String @default("manual") @map("source_type")
  /// JSON blob: original prompt, AI response, raw API payload, etc. For an
  /// article auto-generated from a topic candidate, includes
  /// `{ topicCandidateId: string }` linking it back to the entry in
  /// `Edition.topicCandidates` that produced it (see `Edition.curatorMarks`).
  sourceData String? @map("source_data")
  /// True hides the article from the public edition page (`editionArticles()`
  /// in `src/lib/editions.ts`) while keeping it intact and editable in the
  /// admin. Set via the curation UI when the admin unmarks the topic
  /// candidate this article came from — never set on manually-authored
  /// articles, which have no candidate to unmark.
  hidden Boolean @default(false) @map("hidden")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  edition      Edition              @relation(fields: [editionId], references: [id], onDelete: Cascade)
  repoMentions ArticleRepoMention[]

  @@unique([editionId, dayDate])
  @@index([editionId])
  @@index([editionId, order])
  @@map("articles")
}

/// Which repositories one article actually talks about — written by
/// `assemble-day-post` (`@/mastra/workflows/day-post`) from the repos its
/// assembled sections reference.
///
/// Exists so "have we covered this repo before?" is an indexed lookup on
/// `repoFullName` instead of a scan of every prior article's markdown, which is
/// what `research-day` asks on every run. Deliberately a join table rather than a
/// JSON array on `Article` (the convention elsewhere in this schema): the query
/// goes *from* a repo *to* the articles, which a JSON blob cannot index.
///
/// Like `Repo`, keyed by the `"owner/name"` string with no FK to `Repo` — a
/// mention is a record of what an article said, and must survive the repo row
/// being absent or never enriched.
model ArticleRepoMention {
  id        Int @id @default(autoincrement())
  articleId Int @map("article_id")

  /// "owner/name" — matches `Repo.fullName` / `ServiceActivity.repo`.
  repoFullName String @map("repo_full_name")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, repoFullName])
  @@index([repoFullName])
  @@map("article_repo_mentions")
}

/// Raw external service event stored before AI summarisation.
/// Ported from `app/models/service_activity.py`.
model ServiceActivity {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  /// e.g. "github" | "blog" | "spotify".
  source String @default("github")
  /// e.g. "commit" | "pr" | "star" | "post" | "spotify_track" | "spotify_artist".
  eventType String  @map("event_type")
  repo      String?
  title     String
  url       String?
  timestamp DateTime?
  rawJson   String?   @map("raw_json")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([source])
  @@map("service_activities")
}

/// One attempt at processing one UTC calendar day of an edition — the record
/// of the *attempt*, not of its evidence. `ServiceActivity` rows only show
/// what a day found; without this table a day with genuinely zero GitHub
/// activity is indistinguishable from a day nobody ever processed.
///
/// One row per `(editionId, date)`, claimed atomically by
/// `claimDayProcessingRun` (`src/lib/generation/daily.ts`) — the unique
/// constraint is what makes several days processable concurrently without a
/// shared lock, and what stops the same day being started twice. A row stuck
/// at `"running"` (server killed mid-run) is reclaimable after a staleness
/// window rather than blocking that day forever.
model DayProcessingRun {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  /// UTC midnight of the day this run is for.
  date DateTime
  /// "running" | "done" | "failed".
  status     String
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  /// Set on "done" — did this run find any real GitHub activity for the day?
  /// `false` is the honest "processed, and there was nothing" state.
  hadActivity Boolean? @map("had_activity")
  /// Set on "failed" — the thrown error's message.
  error String?

  /// "pending" | "running" | "done" | "failed" — the day's *post generation*
  /// (`@/mastra/workflows/day-post`), deliberately separate from `status` above,
  /// which stays about the activity fetch/enrichment. They are different fallible
  /// steps with different retry semantics: a day whose activity fetch succeeded
  /// but whose post failed should say exactly that. `null` for a run that never
  /// attempted a post.
  postStatus String? @map("post_status")
  /// JSON, nullable — live per-section progress while `postStatus === "running"`,
  /// same `{ totalSections, completedSections, sections: [...] }` shape (and
  /// plain-`String`-column convention) as `Edition.generationProgress`.
  postProgress String? @map("post_progress")
  /// Last time the post run wrote anything — set on every `postStatus:
  /// "running"` write (`runTrackedDayPostGeneration`), so a `"running"` row
  /// older than `STALE_RUN_MS` is one whose process died. A *heartbeat* rather
  /// than a start time on purpose: `startedAt` above belongs to the activity
  /// phase, and a post run legitimately takes 6-11 minutes — longer than the
  /// staleness window — so timing it from its start alone would report every
  /// healthy long run as stuck.
  postHeartbeatAt DateTime? @map("post_heartbeat_at")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, date])
  @@map("day_processing_runs")
}

/// Persisted GitHub facts for one repository, refreshed whenever a day that
/// starred it is (re)processed — `enrichStarredRepos`
/// (`src/lib/generation/daily.ts`).
///
/// Deliberately keyed by `fullName` ("owner/name") with **no** foreign key to
/// `ServiceActivity`: the day page matches `ServiceActivity.repo` against this
/// table by string equality at query time, which avoids touching/backfilling
/// that (unkeyed, delete-and-reinsert) table at all. The JSON-string columns
/// mirror the rest of this schema's blob convention (`Edition.githubStats`,
/// `ServiceActivity.rawJson`) — SQLite has no array/JSON column type here.
model Repo {
  id       Int    @id @default(autoincrement())
  /// "owner/name" — matches `ServiceActivity.repo`.
  fullName String @unique @map("full_name")

  description      String?
  stargazersCount  Int? @map("stargazers_count")
  forksCount       Int? @map("forks_count")
  openIssuesCount  Int? @map("open_issues_count")
  subscribersCount Int? @map("subscribers_count")
  /// SPDX id, or the license's name when it has no SPDX id.
  license          String?
  /// JSON `string[]`.
  topics           String?
  /// JSON `Array<{ name, bytes, pct }>` — `fetchRepoFacts`' shape, not GitHub's raw byte map.
  languages        String?
  /// JSON `{ count, latestTag, latestDate, cadenceDays }`.
  latestRelease    String? @map("latest_release")
  /// JSON `number[]` — up to 52 weekly commit counts; absent while GitHub is still computing them (202).
  weeklyCommits    String? @map("weekly_commits")

  lastEnrichedAt DateTime? @map("last_enriched_at")
  /// Last enrichment failure, if any — surfaced instead of silently stale figures.
  enrichError    String?   @map("enrich_error")

  @@map("repos")
}

/// Persisted OAuth token for an external service (one row per service).
/// Ported from `app/models/service_token.py`.
model ServiceToken {
  id           Int       @id @default(autoincrement())
  service      String    @unique
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scope        String?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("service_tokens")
}

/// Per-Google-calendar privacy/usage mode. New in the Google Calendar plan
/// (Phase F). One row per calendar the admin's connected Google account has
/// ever been seen to have (populated by `listCalendars()` /
/// `calendarList.list`, cached here as `googleCalendarId` + `name`).
///
/// `mode` is a real privacy control, not a UI convenience — a newly-seen
/// calendar always starts at `"off"`, and the calendar stats ranking
/// (`@/lib/rankings/calendar.ts`) and the meeting-notes source processor
/// (`@/lib/sources/calendar-event.ts`) both check it before ever fetching a
/// calendar's events:
///   "off"      — ignored entirely (default).
///   "stats"    — events feed the aggregate Calendar ranking (count, hours,
///                busiest day, day-of-week distribution) only; event
///                titles/descriptions are never fetched for this calendar.
///   "articles" — events are browsable, one at a time, for manual assisted
///                article/podcast generation; not included in the stats
///                ranking.
///   "both"     — both of the above.
model CalendarSource {
  id Int @id @default(autoincrement())

  /// Google's calendar ID (`calendarList.list` entry's `id`, e.g. an email
  /// address for the primary calendar, or a long opaque ID otherwise).
  googleCalendarId String @unique @map("google_calendar_id")
  /// Cached display name (`summary`) from the Google Calendar API, refreshed
  /// every time the admin syncs the calendar list.
  name String

  /// "off" | "stats" | "articles" | "both".
  mode      String   @default("off")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("calendar_sources")
}

/// Global admin key/value settings. Originally held only the "cadence" key
/// (drives the period new editions are generated for); the web-based-settings
/// plan (see .omc/plans/web-based-settings.md) extends this into the one
/// store every credential/setting eventually lives in, via
/// `src/lib/config/settings.ts`'s `getSetting`/`setSetting`.
model Setting {
  key       String   @id
  value     String
  /// True when `value` is ciphertext produced by `src/lib/config/crypto.ts`
  /// (AES-256-GCM) rather than a plaintext string. Existing rows (`cadence`,
  /// `scheduleCron`, `scheduleEnabled`) default to `false`, matching their
  /// unchanged plaintext behavior.
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Connected social-network account used for auto-posting on publish. New in
/// the agent-editions/social/newsletter plan (Phase D).
///
/// Deliberately NOT `ServiceToken` (the model Spotify uses): `ServiceToken`'s
/// shape (accessToken/refreshToken/expiresAt/scope) is an OAuth-token-pair
/// shape, and two of the three networks here don't fit it — Bluesky
/// authenticates with an identifier + app password (not an OAuth token at
/// all), and Mastodon needs a user-configured instance URL stored alongside
/// its access token (a field `ServiceToken` has no room for). Rather than
/// stretch `ServiceToken`'s columns to mean different things per service,
/// credentials are stored as a per-service-shaped JSON blob:
///   twitter:  { accessToken, refreshToken, expiresAt }  (OAuth 2.0 + PKCE)
///   bluesky:  { identifier, appPassword }
///   mastodon: { instanceUrl, accessToken }
/// One row per service; connecting replaces the row, disconnecting deletes it
/// (mirrors the Spotify `ServiceToken` connect/disconnect UX).
model SocialAccount {
  id      Int     @id @default(autoincrement())
  /// "twitter" | "bluesky" | "mastodon"
  service String  @unique
  /// Per-network on/off toggle. A disconnected network has no row at all; an
  /// account can also be connected-but-disabled without losing its stored
  /// credentials.
  enabled Boolean @default(true)
  /// JSON blob, shape documented above.
  credentials String   @map("credentials_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("social_accounts")
}

/// Email newsletter subscriber. New in the agent-editions/social/newsletter
/// plan — no Flask/Python equivalent. Double opt-in: a row is created as
/// "pending" on subscribe, flipped to "confirmed" via the emailed
/// `confirmToken` link, and to "unsubscribed" via the emailed
/// `unsubscribeToken` link (present in every summary email, no login
/// required).
model Subscriber {
  id    Int    @id @default(autoincrement())
  email String @unique

  /// "pending" | "confirmed" | "unsubscribed".
  status           String    @default("pending")
  confirmToken     String    @unique @map("confirm_token")
  unsubscribeToken String    @unique @map("unsubscribe_token")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@index([status])
  @@map("subscribers")
}
