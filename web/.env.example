# Database (Prisma / SQLite). In Docker this is overridden by docker-compose.yml.
DATABASE_URL="file:./dev.db"

# Admin
ADMIN_PASSWORD=change-me-in-production
# Signs the admin session cookie (the equivalent of Flask's SECRET_KEY).
# Optional: falls back to ADMIN_PASSWORD when unset.
SESSION_SECRET=dev-secret-key-change-in-production

# Bearer token for the JSON API. If unset, the API is open (dev-friendly).
API_TOKEN=your-super-secret-token

# Newspaper identity
NEWSPAPER_NAME=¡Albricias!
NEWSPAPER_TAGLINE="All the News That's Fit to Print"
NEWSPAPER_PRICE=Two Cents
NEWSPAPER_METADATA_RIGHT="This is a test"

# GitHub integration (personal access token + your username)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_USERNAME=your_github_username

# OpenAI (used by the Mastra agents for article generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Blog RSS feed used as an activity source alongside GitHub
BLOG_RSS_URL=https://example.com/feed.xml

# Spotify (for listening data in generated editions)
# 1. Create an app at https://developer.spotify.com/dashboard
# 2. Add the redirect URI below to your Spotify app's "Redirect URIs" list
# 3. Visit /admin/spotify/connect to authorise your account
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/admin/spotify/callback
