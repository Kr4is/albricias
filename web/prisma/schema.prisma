// Albricias data layer.
//
// Ported 1:1 from the Flask/SQLAlchemy models under the repo-root `app/models/`,
// with one deliberate generalisation: `Edition` no longer stores `month`/`year`
// integers but a `cadence` + `periodStart`/`periodEnd` range, so weekly and
// monthly editions share one model (see .omc/plans/react-mastra-rewrite.md).
//
// Table and column names are `@map`-ed to the original snake_case SQLite names
// so the Phase 5 migration script can move rows across with a 1:1 mapping.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One publication covering a single period (a week or a month).
/// Ported from `app/models/edition.py`.
model Edition {
  id Int @id @default(autoincrement())

  /// "weekly" | "monthly" — see CADENCE_* in src/lib/edition-helpers.ts.
  cadence String @default("monthly")
  /// Inclusive start of the covered period, at 00:00 UTC.
  periodStart DateTime @map("period_start")
  /// Exclusive end of the covered period, at 00:00 UTC.
  periodEnd DateTime @map("period_end")

  title String
  /// "draft" | "published" — see EDITION_STATUS_* in src/lib/edition-helpers.ts.
  status      String    @default("draft")
  coverImage  String?   @map("cover_image")
  vol         String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  articles          Article[]
  serviceActivities ServiceActivity[]

  @@unique([cadence, periodStart], map: "uq_edition_cadence_period_start")
  @@index([status])
  @@index([periodStart])
  @@map("editions")
}

/// Individual piece of content within an edition.
/// Ported from `app/models/article.py`.
model Article {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  title    String
  content  String
  category String  @default("General")
  author   String?
  deck     String  @default("A")
  order    Int     @default(0)
  /// Optional dateline. Stored as a DateTime; only the date part is meaningful.
  date DateTime?

  // Media — image/audio stored locally; video is always a URL.
  image String?
  audio String?
  video String?

  /// Provenance: "manual" | "ai_generated" | "github".
  sourceType String @default("manual") @map("source_type")
  /// JSON blob: original prompt, AI response, raw API payload, etc.
  sourceData String? @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([editionId, order])
  @@map("articles")
}

/// Raw external service event stored before AI summarisation.
/// Ported from `app/models/service_activity.py`.
model ServiceActivity {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  /// e.g. "github" | "blog" | "spotify".
  source String @default("github")
  /// e.g. "commit" | "pr" | "star" | "post" | "spotify_track" | "spotify_artist".
  eventType String  @map("event_type")
  repo      String?
  title     String
  url       String?
  timestamp DateTime?
  rawJson   String?   @map("raw_json")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([source])
  @@map("service_activities")
}

/// Persisted OAuth token for an external service (one row per service).
/// Ported from `app/models/service_token.py`.
model ServiceToken {
  id           Int       @id @default(autoincrement())
  service      String    @unique
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scope        String?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("service_tokens")
}

/// Global admin key/value settings. Currently holds the "cadence" key,
/// which drives the period new editions are generated for.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Connected social-network account used for auto-posting on publish. New in
/// the agent-editions/social/newsletter plan (Phase D).
///
/// Deliberately NOT `ServiceToken` (the model Spotify uses): `ServiceToken`'s
/// shape (accessToken/refreshToken/expiresAt/scope) is an OAuth-token-pair
/// shape, and two of the three networks here don't fit it — Bluesky
/// authenticates with an identifier + app password (not an OAuth token at
/// all), and Mastodon needs a user-configured instance URL stored alongside
/// its access token (a field `ServiceToken` has no room for). Rather than
/// stretch `ServiceToken`'s columns to mean different things per service,
/// credentials are stored as a per-service-shaped JSON blob:
///   twitter:  { accessToken, refreshToken, expiresAt }  (OAuth 2.0 + PKCE)
///   bluesky:  { identifier, appPassword }
///   mastodon: { instanceUrl, accessToken }
/// One row per service; connecting replaces the row, disconnecting deletes it
/// (mirrors the Spotify `ServiceToken` connect/disconnect UX).
model SocialAccount {
  id      Int     @id @default(autoincrement())
  /// "twitter" | "bluesky" | "mastodon"
  service String  @unique
  /// Per-network on/off toggle. A disconnected network has no row at all; an
  /// account can also be connected-but-disabled without losing its stored
  /// credentials.
  enabled Boolean @default(true)
  /// JSON blob, shape documented above.
  credentials String   @map("credentials_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("social_accounts")
}

/// Email newsletter subscriber. New in the agent-editions/social/newsletter
/// plan — no Flask/Python equivalent. Double opt-in: a row is created as
/// "pending" on subscribe, flipped to "confirmed" via the emailed
/// `confirmToken` link, and to "unsubscribed" via the emailed
/// `unsubscribeToken` link (present in every summary email, no login
/// required).
model Subscriber {
  id    Int    @id @default(autoincrement())
  email String @unique

  /// "pending" | "confirmed" | "unsubscribed".
  status           String    @default("pending")
  confirmToken     String    @unique @map("confirm_token")
  unsubscribeToken String    @unique @map("unsubscribe_token")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@index([status])
  @@map("subscribers")
}
