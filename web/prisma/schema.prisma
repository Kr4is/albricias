// Albricias data layer.
//
// Ported 1:1 from the Flask/SQLAlchemy models under the repo-root `app/models/`,
// with one deliberate generalisation: `Edition` no longer stores `month`/`year`
// integers but a `cadence` + `periodStart`/`periodEnd` range, so weekly and
// monthly editions share one model (see .omc/plans/react-mastra-rewrite.md).
//
// Table and column names are `@map`-ed to the original snake_case SQLite names
// so the Phase 5 migration script can move rows across with a 1:1 mapping.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One publication covering a single period (a week or a month).
/// Ported from `app/models/edition.py`.
model Edition {
  id Int @id @default(autoincrement())

  /// "weekly" | "monthly" — see CADENCE_* in src/lib/edition-helpers.ts.
  cadence String @default("monthly")
  /// Inclusive start of the covered period, at 00:00 UTC.
  periodStart DateTime @map("period_start")
  /// Exclusive end of the covered period, at 00:00 UTC.
  periodEnd DateTime @map("period_end")

  title String
  /// "draft" | "published" — see EDITION_STATUS_* in src/lib/edition-helpers.ts.
  status      String    @default("draft")
  coverImage  String?   @map("cover_image")
  vol         String
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// "running" | "done" — tracks the async "Generate with AI" pipeline
  /// (see runEditionGeneration in src/lib/generation/index.ts) so
  /// /admin/editions/[id]/edit can show a live view while it's in progress.
  /// Editions not created through that flow (manual add, migrated data)
  /// are "done" from the start — there is nothing in progress for them.
  generationStatus String @default("done") @map("generation_status")
  /// JSON, nullable, only meaningful while `generationStatus === "running"` —
  /// incremental progress for the live SSE view
  /// (`/admin/editions/[id]/live`), cleared back to `null` once generation
  /// finishes (see the `finally` block in `populateEditionDraft`). Shape:
  ///   {
  ///     sourceProgress: { github: "pending"|"fetching"|"done"|"skipped", blog: ..., spotify: ..., alexandria: ... },
  ///     totalSections: number,
  ///     completedSections: number,
  ///     sections: [{ category: string, status: "pending"|"writing"|"done"|"failed"|"aborted" }]
  ///   }
  generationProgress String? @map("generation_progress")

  articles          Article[]
  serviceActivities ServiceActivity[]

  @@unique([cadence, periodStart], map: "uq_edition_cadence_period_start")
  @@index([status])
  @@index([periodStart])
  @@map("editions")
}

/// Individual piece of content within an edition.
/// Ported from `app/models/article.py`.
model Article {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  title    String
  content  String
  category String  @default("General")
  author   String?
  deck     String  @default("A")
  order    Int     @default(0)
  /// Optional dateline. Stored as a DateTime; only the date part is meaningful.
  date DateTime?

  // Media — image/audio stored locally; video is always a URL.
  image String?
  audio String?
  video String?

  /// Provenance: "manual" | "ai_generated" | "github".
  sourceType String @default("manual") @map("source_type")
  /// JSON blob: original prompt, AI response, raw API payload, etc.
  sourceData String? @map("source_data")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([editionId, order])
  @@map("articles")
}

/// Raw external service event stored before AI summarisation.
/// Ported from `app/models/service_activity.py`.
model ServiceActivity {
  id        Int @id @default(autoincrement())
  editionId Int @map("edition_id")

  /// e.g. "github" | "blog" | "spotify".
  source String @default("github")
  /// e.g. "commit" | "pr" | "star" | "post" | "spotify_track" | "spotify_artist".
  eventType String  @map("event_type")
  repo      String?
  title     String
  url       String?
  timestamp DateTime?
  rawJson   String?   @map("raw_json")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([source])
  @@map("service_activities")
}

/// Persisted OAuth token for an external service (one row per service).
/// Ported from `app/models/service_token.py`.
model ServiceToken {
  id           Int       @id @default(autoincrement())
  service      String    @unique
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scope        String?
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("service_tokens")
}

/// Per-Google-calendar privacy/usage mode. New in the Google Calendar plan
/// (Phase F). One row per calendar the admin's connected Google account has
/// ever been seen to have (populated by `listCalendars()` /
/// `calendarList.list`, cached here as `googleCalendarId` + `name`).
///
/// `mode` is a real privacy control, not a UI convenience — a newly-seen
/// calendar always starts at `"off"`, and the calendar stats ranking
/// (`@/lib/rankings/calendar.ts`) and the meeting-notes source processor
/// (`@/lib/sources/calendar-event.ts`) both check it before ever fetching a
/// calendar's events:
///   "off"      — ignored entirely (default).
///   "stats"    — events feed the aggregate Calendar ranking (count, hours,
///                busiest day, day-of-week distribution) only; event
///                titles/descriptions are never fetched for this calendar.
///   "articles" — events are browsable, one at a time, for manual assisted
///                article/podcast generation; not included in the stats
///                ranking.
///   "both"     — both of the above.
model CalendarSource {
  id Int @id @default(autoincrement())

  /// Google's calendar ID (`calendarList.list` entry's `id`, e.g. an email
  /// address for the primary calendar, or a long opaque ID otherwise).
  googleCalendarId String @unique @map("google_calendar_id")
  /// Cached display name (`summary`) from the Google Calendar API, refreshed
  /// every time the admin syncs the calendar list.
  name String

  /// "off" | "stats" | "articles" | "both".
  mode      String   @default("off")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("calendar_sources")
}

/// Global admin key/value settings. Originally held only the "cadence" key
/// (drives the period new editions are generated for); the web-based-settings
/// plan (see .omc/plans/web-based-settings.md) extends this into the one
/// store every credential/setting eventually lives in, via
/// `src/lib/config/settings.ts`'s `getSetting`/`setSetting`.
model Setting {
  key       String   @id
  value     String
  /// True when `value` is ciphertext produced by `src/lib/config/crypto.ts`
  /// (AES-256-GCM) rather than a plaintext string. Existing rows (`cadence`,
  /// `scheduleCron`, `scheduleEnabled`) default to `false`, matching their
  /// unchanged plaintext behavior.
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

/// Connected social-network account used for auto-posting on publish. New in
/// the agent-editions/social/newsletter plan (Phase D).
///
/// Deliberately NOT `ServiceToken` (the model Spotify uses): `ServiceToken`'s
/// shape (accessToken/refreshToken/expiresAt/scope) is an OAuth-token-pair
/// shape, and two of the three networks here don't fit it — Bluesky
/// authenticates with an identifier + app password (not an OAuth token at
/// all), and Mastodon needs a user-configured instance URL stored alongside
/// its access token (a field `ServiceToken` has no room for). Rather than
/// stretch `ServiceToken`'s columns to mean different things per service,
/// credentials are stored as a per-service-shaped JSON blob:
///   twitter:  { accessToken, refreshToken, expiresAt }  (OAuth 2.0 + PKCE)
///   bluesky:  { identifier, appPassword }
///   mastodon: { instanceUrl, accessToken }
/// One row per service; connecting replaces the row, disconnecting deletes it
/// (mirrors the Spotify `ServiceToken` connect/disconnect UX).
model SocialAccount {
  id      Int     @id @default(autoincrement())
  /// "twitter" | "bluesky" | "mastodon"
  service String  @unique
  /// Per-network on/off toggle. A disconnected network has no row at all; an
  /// account can also be connected-but-disabled without losing its stored
  /// credentials.
  enabled Boolean @default(true)
  /// JSON blob, shape documented above.
  credentials String   @map("credentials_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("social_accounts")
}

/// Email newsletter subscriber. New in the agent-editions/social/newsletter
/// plan — no Flask/Python equivalent. Double opt-in: a row is created as
/// "pending" on subscribe, flipped to "confirmed" via the emailed
/// `confirmToken` link, and to "unsubscribed" via the emailed
/// `unsubscribeToken` link (present in every summary email, no login
/// required).
model Subscriber {
  id    Int    @id @default(autoincrement())
  email String @unique

  /// "pending" | "confirmed" | "unsubscribed".
  status           String    @default("pending")
  confirmToken     String    @unique @map("confirm_token")
  unsubscribeToken String    @unique @map("unsubscribe_token")
  subscribedAt     DateTime  @default(now()) @map("subscribed_at")
  confirmedAt      DateTime? @map("confirmed_at")
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  @@index([status])
  @@map("subscribers")
}
