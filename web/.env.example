# Database (Prisma / SQLite). In Docker this is overridden by docker-compose.yml.
# This is the only environment variable this app reads. Every other setting
# (admin password, OpenAI, GitHub, Spotify/X/Google OAuth credentials, SMTP,
# branding, Alexandria, the JSON API token) is configured exclusively through
# the web interface: visit the app once this is set to walk through the
# first-run /setup wizard, then use /admin/settings and /admin/account for
# everything else.
DATABASE_URL="file:./dev.db"
