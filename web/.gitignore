# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite database (DATABASE_URL=file:./dev.db resolves from this dir)
/*.db
/*.db-journal

# settings encryption key (src/lib/config/crypto.ts) — generated as a sibling
# of the sqlite file above; in Docker it lives under the gitignored
# repo-root `instance/` bind mount instead, but local dev's DATABASE_URL
# resolves to this directory, so guard for it here too. Back this up
# alongside the database — losing it makes every encrypted Setting
# unreadable.
/settings.key
